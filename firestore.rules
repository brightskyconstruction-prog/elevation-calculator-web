rules_version = '2';
// ─── Firestore Security Rules ─────────────────────────────────────────────────
//
// Collections:
//   /users/{userId}          — app data  (points, sets, history)
//   /userProfiles/{userId}   — account   (plan, subscription, feature flags)
//
// Future collections (no rules needed until documents are written):
//   /subscriptions/{subId}   — payment gateway subscription records
//   /payments/{paymentId}    — payment history
//   /invoices/{invoiceId}    — invoice records
//   /promotions/{promoCode}  — promo / coupon codes  (admin write only)
//   /featureFlags/{flagId}   — global feature toggles (admin write only)
//
// CURRENT MODEL: "email as identity"
//   userId = base64(email) — no server-side token verification yet.
//   Any client that knows the userId can read/write their own documents.
//   Appropriate for a trusted internal/team tool.
//
// ── Upgrading to real auth in the future ──────────────────────────────────────
// 1. Add Firebase Authentication (email/password or magic link).
// 2. Replace userId key with request.auth.uid throughout the app.
// 3. Replace `allow read, write: if true` with:
//      allow read, write: if request.auth != null
//                         && request.auth.uid == userId;
// 4. For admin-only writes (promotions, featureFlags):
//      allow write: if request.auth.token.isAdmin == true;
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── App data: survey points, sets, calculator history ────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── Account data: plan, subscription status, feature entitlements ────────
    // Client can read its own profile to check features.
    // Client can write on login (ensureUserProfile) and on profile updates.
    // Future: restrict writes to Cloud Functions only (Stripe webhook handler).
    match /userProfiles/{userId} {
      allow read, write: if true;
    }

    // ── Future: subscription records (written by payment webhook) ─────────────
    // match /subscriptions/{subId} {
    //   allow read:  if true;
    //   allow write: if false; // Cloud Functions only
    // }

    // ── Future: payment history (written by payment webhook) ──────────────────
    // match /payments/{paymentId} {
    //   allow read:  if true;
    //   allow write: if false;
    // }

    // ── Future: promo codes (admin write, public read for validation) ─────────
    // match /promotions/{promoCode} {
    //   allow read:  if true;
    //   allow write: if request.auth.token.isAdmin == true;
    // }

    // ── Future: feature flags (admin only) ────────────────────────────────────
    // match /featureFlags/{flagId} {
    //   allow read:  if true;
    //   allow write: if request.auth.token.isAdmin == true;
    // }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
