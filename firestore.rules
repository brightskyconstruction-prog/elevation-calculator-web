rules_version = '2';
// ─── Firestore Security Rules ─────────────────────────────────────────────────
//
// Collections:
//   /users/{userId}          — app data  (points, sets, history)
//   /userProfiles/{userId}   — account   (plan, subscription, feature flags)
//
// SECURITY MODEL (v1.2 — Firebase Email Link Auth + per-user isolation)
//   Authentication:
//     Users sign in via Firebase Email Link (passwordless).
//     Firebase assigns each user a stable, random UID.
//     That UID is used as the Firestore document key in both collections.
//
//   Per-user isolation:
//     request.auth.uid == userId ensures each authenticated user can ONLY
//     read and write their own document. No user can access another user's
//     data — even if they somehow know the path.
//
//   Guest users:
//     Guests have no Firebase Auth session. All Firestore reads/writes are
//     denied. Guests use local storage only — no cloud sync.
//
// ── Future hardening ──────────────────────────────────────────────────────────
//   Admin-only writes (promotions, featureFlags, plan upgrades):
//     allow write: if request.auth.token.admin == true;
//
//   Stripe webhook writes (server-side only):
//     allow write: if false; // Cloud Functions only
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── App data: survey points, sets, calculator history ────────────────────
    // Only the owning user (matched by Firebase UID) can read or write.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Account data: plan, subscription status, feature entitlements ────────
    // Only the owning user can read or write their own profile.
    // Future: tighten writes to Cloud Functions only (Stripe webhook handler).
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Future: subscription records (written by payment webhook) ─────────────
    // match /subscriptions/{subId} {
    //   allow read:  if request.auth != null;
    //   allow write: if false; // Cloud Functions only
    // }

    // ── Future: payment history (written by payment webhook) ──────────────────
    // match /payments/{paymentId} {
    //   allow read:  if request.auth != null;
    //   allow write: if false;
    // }

    // ── Future: promo codes (admin write, public read for validation) ─────────
    // match /promotions/{promoCode} {
    //   allow read:  if request.auth != null;
    //   allow write: if request.auth.token.admin == true;
    // }

    // ── Future: feature flags (admin only) ────────────────────────────────────
    // match /featureFlags/{flagId} {
    //   allow read:  if request.auth != null;
    //   allow write: if request.auth.token.admin == true;
    // }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
