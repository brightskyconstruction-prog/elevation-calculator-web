rules_version = '2';
// ─── Firestore Security Rules ─────────────────────────────────────────────────
//
// Collections:
//   /users/{userId}          — app data  (points, sets, history)
//   /userProfiles/{userId}   — account   (plan, subscription, feature flags)
//
// SECURITY MODEL (v1.1 — Anonymous Auth required)
//   The app signs every session in with Firebase Anonymous Auth on startup.
//   Rules require request.auth != null — completely unauthenticated callers
//   (bots, scripts, raw HTTP) are denied. Only clients holding a valid
//   Firebase Auth token (obtained from our app) can read or write.
//
//   userId is still base64(email) in this release. Cross-user access
//   protection (request.auth.uid == userId) requires migrating from
//   email-derived IDs to Firebase UID-based routing — planned for v1.2.
//
// ── Phase 2 upgrade (when Firebase Email Link auth is shipped) ────────────────
// 1. Replace anonymous sign-in with email-link sign-in.
// 2. Route Firestore docs by request.auth.uid instead of btoa(email).
// 3. Tighten rules to:
//      allow read, write: if request.auth != null
//                         && request.auth.uid == userId;
// 4. Admin-only writes (promotions, featureFlags):
//      allow write: if request.auth.token.admin == true;
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── App data: survey points, sets, calculator history ────────────────────
    // Requires a valid Firebase Auth session (anonymous or signed-in).
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Account data: plan, subscription status, feature entitlements ────────
    // Client can read its own profile to check features.
    // Client can write on login (ensureUserProfile) and on profile updates.
    // Future: restrict writes to Cloud Functions only (Stripe webhook handler).
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null;
    }

    // ── Future: subscription records (written by payment webhook) ─────────────
    // match /subscriptions/{subId} {
    //   allow read:  if request.auth != null;
    //   allow write: if false; // Cloud Functions only
    // }

    // ── Future: payment history (written by payment webhook) ──────────────────
    // match /payments/{paymentId} {
    //   allow read:  if request.auth != null;
    //   allow write: if false;
    // }

    // ── Future: promo codes (admin write, public read for validation) ─────────
    // match /promotions/{promoCode} {
    //   allow read:  if request.auth != null;
    //   allow write: if request.auth.token.admin == true;
    // }

    // ── Future: feature flags (admin only) ────────────────────────────────────
    // match /featureFlags/{flagId} {
    //   allow read:  if request.auth != null;
    //   allow write: if request.auth.token.admin == true;
    // }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
